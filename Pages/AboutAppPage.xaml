<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dream_Journal_Project.Pages.AboutAppPage"
             Title="About App">
    <Grid RowDefinitions="*,150">
        
        
        
        <VerticalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="50" Grid.Row="1">

            <Border x:Name="GithubBorder"
                    WidthRequest="60"
                    HeightRequest="60"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 10,10,10,10">
                <ImageButton WidthRequest="50" 
                             HeightRequest="50"
                             x:Name="GithubImage"/>
            </Border>
            
            
            
            <Label Text="Author of this App"/>
            <Label Text="NikodemBilinski"/>
        </VerticalStackLayout>
    </Grid>
    
</ContentPage>