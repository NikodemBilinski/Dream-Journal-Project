<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dream_Journal_Project.AddDreamPage">
    

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">
            <Label Text="Add a new dream"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

                <Entry x:Name="Dream_Title" 
                       Placeholder="Title" 
                       Margin="10" 
                       WidthRequest="200"
                       HorizontalOptions="Fill"/>



            <CollectionView x:Name="TagsSelection"
                            SelectionMode="None"
                            HorizontalOptions="Center">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding ColorHex}"
                                Margin="0,0,10,0"
                                HorizontalOptions="Start"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 40,40,0,40">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped">
                                    
                                </TapGestureRecognizer>
                            </Border.GestureRecognizers>
                            
                            <Label Text="{Binding Name}"
                                       Margin="5"
                                       TextColor="Black"/>
                            
                            
                        </Border>
                        
                        
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
            </CollectionView>
            <Editor  x:Name="Dream_Description" 
                     Placeholder="Description" 
                     Margin="10" 
                     HeightRequest="300" />
            
            <Button Text="Save Dream" 
                    Clicked="Save_Dream_Clicked" 
                    VerticalOptions="End"
                    WidthRequest="150"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>