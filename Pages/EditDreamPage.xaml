<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dream_Journal_Project.Pages.EditDreamPage"
             Title="EditDreamPage">
    <VerticalStackLayout>
        <ScrollView>
            <VerticalStackLayout Padding="20"
                                 Spacing="15">


                <Label x:Name="HeaderLabel"
                       Text="StringFormat='Edit {0}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                <HorizontalStackLayout 
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Entry x:Name="Dream_Title" 
                           Placeholder="Title" 
                           Margin="10" 
                           WidthRequest="200"
                           HorizontalOptions="Fill"/>
                    <CollectionView x:Name="TagsSelection"
                                    SelectionMode="None"> 
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{Binding ColorHex}"
                                        StrokeThickness="{Binding CurrentThickness}"
                                        Stroke="Black"
                                        HeightRequest="45"
                                        StrokeShape="RoundRectangle 40,40,0,40">
                                    <Label Text="{Binding Name}"
                                           Margin="5"
                                           TextColor="Black"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"/>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>

                </HorizontalStackLayout>
                <Editor  x:Name="Dream_Description" 
                         Placeholder="Description" 
                         Margin="10" 
                         HeightRequest="300" />

                <Button Text="Save Dream" 
                        Clicked="OnSaveButtonClicked" 
                        VerticalOptions="End"
                        WidthRequest="150"/>

            </VerticalStackLayout>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>