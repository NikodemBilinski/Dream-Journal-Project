<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Dream_Journal_Project.Models"
             x:Class="Dream_Journal_Project.DreamDetailsPage"
             Title="{Binding Title}"
             x:DataType="model:Dream">
    <ScrollView>
    <VerticalStackLayout Padding="20">

        <Label x:Name="Date"
               Text="StringFormat='Date Created: {0}'}"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               FontSize="25"/>
        <HorizontalStackLayout>
        <Label Text="Descritpion of the dream:"
               FontSize="25"/>
        <Label x:Name="LucidDream"
               FontSize="25"/>
            
            </HorizontalStackLayout>

        <Label x:Name="DescriptionLabel"
               Margin="10,20,0,0"/>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>