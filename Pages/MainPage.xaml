<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Dream_Journal_Project.Models"
             xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Dream_Journal_Project.MainPage"
             Title="Dream Journal">
    <ContentPage.ToolbarItems>
        
        <ToolbarItem IconImageSource="refresh.png"
             Clicked="Refresh_Button_Clicked"/>
        <ToolbarItem IconImageSource="book.png"
                     Clicked="Toggle_Filter"/>

    </ContentPage.ToolbarItems>
    
    
    <VerticalStackLayout Padding="20" Spacing="15">
    
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">

            <Button Text="Add Dream" Clicked="On_Add_Dream_Clicked" VerticalOptions="Center" WidthRequest="125"/>
            <Button Text="View Tags" Clicked="On_Tags_Clicked" VerticalOptions="Center" WidthRequest="125"/>

        

        </HorizontalStackLayout>
       

            <VerticalStackLayout>
            <Border x:Name="FilterPanel"
                    IsVisible="False"
                    VerticalOptions="Start"
                    BackgroundColor="Gray"
                    Padding="15">
                <VerticalStackLayout>
                        <Entry Placeholder="Szukaj"/>
                    <HorizontalStackLayout Spacing="20" 
                                           HorizontalOptions="Center" 
                                           Margin="20" 
                                           VerticalOptions="Center">   

                        <VerticalStackLayout>
                                <Label Text="Filter by Date" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Label Text="(Refresh to clear filter)" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        
                        
                            <DatePicker Format="d"
                                        x:Name="DateFilterPicker"
                                        FontSize="Small"
                                        DateSelected="Filter_By_Date"/>
                        
                        
                            <Button Text="Zastosuj" Clicked="Apply_Filters"/>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Dreams}" HeightRequest="350">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Dream">
                    <Border BackgroundColor="Transparent"
                            Stroke="Transparent"
                            HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDreamTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,35,35">
                            <Label Grid.Column="0"
                                   VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:d} | {1}">
                                        <Binding Path="DateCreated"/>
                                        <Binding Path="Title"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Image Source="edit.png"  
                                   HeightRequest="35" 
                                   WidthRequest="35"
                                   Grid.Column="1"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   BackgroundColor="Transparent"
                                   Background="Transparent">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Edit_Clicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="trashbin3.png"  
                                    HeightRequest="35" 
                                    WidthRequest="35"
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    BackgroundColor="Transparent"
                                    Background="Transparent">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Trash_Bin_Clicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <BoxView HeightRequest="1"
                                     VerticalOptions="End"/>
                        </Grid>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--<Button Text="skidibi toilet" Clicked="CleanList" VerticalOptions="Center" WidthRequest="175"/>-->
    </VerticalStackLayout>

</ContentPage>
