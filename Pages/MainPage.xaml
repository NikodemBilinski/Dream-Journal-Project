<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:Dream_Journal_Project.Models"
             xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="Dream_Journal_Project.MainPage"
             Title="Dream Journal">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="LD Techniques"
                     Clicked="LD_Clicked"/>
        <ToolbarItem IconImageSource="chart.png"
                     Clicked="Open_Chart_Page"/>

        <ToolbarItem IconImageSource="refresh.png"
             Clicked="Refresh_Button_Clicked"/>

    </ContentPage.ToolbarItems>
    <VerticalStackLayout Padding="20" Spacing="15">
        
        <Button Text="Add Dream" Clicked="OnAddDreamClicked" VerticalOptions="Center" WidthRequest="175"/>

        <ScrollView>
        <CollectionView ItemsSource="{Binding Dreams}">
        
        <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Dream">
                    <Border BackgroundColor="Transparent"
                            Stroke="Transparent"
                            HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDreamTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,50,50">
                            <Label Grid.Column="0"
                                   VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:d} | {1}">
                                        <Binding Path="DateCreated"/>
                                        <Binding Path="Title"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Image Source="edit.png"  
                                   HeightRequest="45" 
                                   WidthRequest="45"
                                   Grid.Column="1"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"
                                   BackgroundColor="Transparent"
                                   Background="Transparent">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Edit_Clicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="trashbin3.png"  
                                    HeightRequest="50" 
                                    WidthRequest="50"
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    BackgroundColor="Transparent"
                                    Background="Transparent">
                                <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Trash_Bin_Clicked"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            <BoxView HeightRequest="1"
                                     VerticalOptions="End"/>
                        </Grid>
                            
                    </Border>
                </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </ScrollView>


        <!--<Button Text="skidibi toilet" Clicked="CleanList" VerticalOptions="Center" WidthRequest="175"/>-->
    </VerticalStackLayout>

</ContentPage>
