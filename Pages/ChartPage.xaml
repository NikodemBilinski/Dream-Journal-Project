<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Dream_Journal_Project.Pages.ChartPage"
             Title="Dream Statistics">
    <VerticalStackLayout>
        <Label Text="Choose a tag to view it in chart"
               Margin="15"
               FontSize="20"
               VerticalOptions="Center"
               HorizontalOptions="Center"/>

        <Grid RowDefinitions="200,*">
       
            
                <VerticalStackLayout Grid.Row="0">
                    <Grid ColumnDefinitions="200,*" Grid.Row="0">
                    <ImageButton Source="piechart.png" HeightRequest="50" WidthRequest="50" Clicked="ImageButton_Clicked_1" Grid.Column="1"
                                 VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,50,0"/>
                    <ImageButton Source="barchart.png" HeightRequest="50" WidthRequest="50" Clicked="ImageButton_Clicked_2" Grid.Column="1"
                                 VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,115,0"/>

                    <toolkit:Expander x:Name="TagExpander"
                                          Margin="10" 
                                          IsExpanded="True"
                                          Grid.Column="0">
                        
                        <toolkit:Expander.Content>
                            <CollectionView x:Name="ExpanderList"
                                            SelectionMode="Single"
                                            SelectionChanged="ExpanderList_SelectionChanged"
                                            HeightRequest="140">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="Transparent" Padding="10"
                                                StrokeShape="RoundRectangle 40,40,40,40">

                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="darkgray"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerOver"/>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>


                                            <Label Text="{Binding Name}" Padding="10"/>

                                        </Border>
                                    </DataTemplate>
                                    
                                </CollectionView.ItemTemplate>
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>
                                </CollectionView.ItemsLayout>
                                 
                               

                            </CollectionView>
                            
                            

                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                </Grid>
                </VerticalStackLayout>
           


            <VerticalStackLayout Grid.Row="1">
                
            
            <charts:ChartView x:Name="DreamChart" 
                              HeightRequest="200"
                              WidthRequest="200"
                              Margin="20"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
            
                <BoxView x:Name="Box_1"
                         WidthRequest="20"
                         HeightRequest="20"
                         VerticalOptions="Center"/>
            
                <Label x:Name="Box_1_Label"
                       FontSize="20"/>
            
            </HorizontalStackLayout>
        
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
            
                <BoxView x:Name="Box_2"
                         WidthRequest="0"
                         HeightRequest="0"
                         VerticalOptions="Center"/>

                <Label x:Name="Box_2_Label"
                       FontSize="20"/>
            
            </HorizontalStackLayout>

            </VerticalStackLayout>

        </Grid>
    </VerticalStackLayout>
</ContentPage>